services:
  postgres:
    image: postgis/postgis:17-3.5
    environment:
      POSTGRES_USER: ride
      POSTGRES_PASSWORD: ride_password
      POSTGRES_DB: ride_platform
    ports:
      - "5432:5432"
    volumes:
      - ride_postgres:/var/lib/postgresql/data
      - ./infrastructure/postgres/init.sql:/docker-entrypoint-initdb.d/01-postgis.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ride -d ride_platform"]
      interval: 5s
      timeout: 5s
      retries: 10

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    command: redis-server --appendonly yes
    volumes:
      - ride_redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  ride_postgres:
  ride_redis:
