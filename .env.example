NODE_ENV="development"
DATABASE_URL="postgresql://ride:ride_password@127.0.0.1:55432/ride_platform?schema=public"
REDIS_URL="redis://127.0.0.1:6379"
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="30"
# Calendar dates for bookings, driver schedules and operational runs are resolved in this timezone.
SERVICE_TIME_ZONE="Asia/Damascus"
# Keep false while the portal and API are on unrelated sites. Enable after moving the API to a same-site host such as api.example.com.
AUTH_REFRESH_COOKIE_ENABLED="false"
AUTH_REFRESH_COOKIE_NAME="ride_refresh_token"
# Production default is true; local HTTP tests can set false explicitly.
# AUTH_REFRESH_COOKIE_SECURE="true"
AUTH_REFRESH_COOKIE_SAME_SITE="lax"
# Leave empty for a host-only cookie. Usually no Domain override is needed for api.example.com.
# AUTH_REFRESH_COOKIE_DOMAIN=""
PORT=4000
WEB_ORIGINS="http://localhost:3000,http://172.20.10.2:3000"
# Behind Render's reverse proxy use 1. If another trusted proxy/CDN is added in front, adjust deliberately.
TRUST_PROXY_HOPS="1"
# Structured one-line HTTP request logs are enabled by default in production and disabled elsewhere.
# Logs contain request id, method, route template, status, and duration only; no body/query/auth/cookies.
# Successful health probes are intentionally omitted to avoid log noise.
# HTTP_REQUEST_LOG_ENABLED="true"
# Authentication abuse protection. Redis is used when available; a per-instance fallback is used otherwise.
AUTH_RATE_LIMIT_ENABLED="true"
AUTH_LOGIN_IP_MAX="40"
AUTH_LOGIN_IDENTITY_MAX="8"
AUTH_LOGIN_WINDOW_SECONDS="900"
AUTH_REGISTER_IP_MAX="6"
AUTH_REGISTER_WINDOW_SECONDS="3600"
AUTH_REFRESH_IP_MAX="120"
AUTH_REFRESH_WINDOW_SECONDS="900"
# Public pre-login ticket analysis is intentionally stricter because it calls the AI extraction service.
TICKET_ANALYSIS_IP_MAX="12"
TICKET_ANALYSIS_WINDOW_SECONDS="3600"
# Driver GPS ingest protection. The mobile client normally sends at most every 5 seconds;
# the server-side floor protects PostgreSQL/realtime from buggy or abusive clients.
GPS_SERVER_MIN_INTERVAL_MS="1500"
# Swagger is enabled by default outside production and disabled by default in production.
# SWAGGER_ENABLED="true"
# Make /api/health/ready fail when Redis is unavailable. Database is always required.
HEALTH_REQUIRE_REDIS="false"
NEXT_PUBLIC_API_URL=https://ride-platform-starter.onrender.com/api
# Canonical public portal origin used by metadata, robots.txt, sitemap.xml and share links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_ALLOWED_DEV_ORIGINS="172.20.10.2"
# Browser map tiles. Prefer a URL-restricted Mapbox public token in production.
# When both values below are empty the portal falls back to the public OSM tile server for development/testing.
NEXT_PUBLIC_MAPBOX_TOKEN=""
# Optional custom tile provider instead of Mapbox. Must contain {z}, {x}, {y} placeholders.
NEXT_PUBLIC_MAP_TILE_URL=""
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=""
MEDIA_STORAGE_ROOT="./storage/media"
MEDIA_MAX_FILE_MB="10"
# Optional override. Default: true in production, false elsewhere.
# MEDIA_REQUIRE_R2="true"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_KEY_PREFIX="ride-platform/media"
COMPLIANCE_EXPIRY_CHECK_MINUTES="60"
PUBLIC_API_URL="http://localhost:4000"
PORTAL_URL="http://localhost:3000"

# Automatic flight-ticket extraction (never commit a real key)
GEMINI_API_KEY=""
GEMINI_TICKET_MODEL="gemini-flash-latest"

# Meta WhatsApp Cloud API (never commit real credentials)
WHATSAPP_ENABLED="false"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_GRAPH_API_VERSION="v25.0"
WHATSAPP_STATUS_TEMPLATE="ride_booking_update"
WHATSAPP_TEMPLATE_LANGUAGE="ar"
WHATSAPP_QUEUE_INTERVAL_MS="15000"

# Telegram booking alerts (never commit a real bot token)
TELEGRAM_ENABLED="false"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_QUEUE_INTERVAL_MS="15000"
TELEGRAM_TIME_ZONE="Asia/Damascus"
