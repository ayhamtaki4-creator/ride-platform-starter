{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alnokhbaeducation",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "tareeqalsham.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMIT",
      "namespace_id": "2410801",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ]
}
